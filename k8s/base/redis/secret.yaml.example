apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/component: cache
type: Opaque
stringData:
  # IMPORTANT: Replace this value in production!
  # Use: kubectl create secret generic redis-secret --from-literal=...
  # Or use sealed-secrets/external-secrets for production
  REDIS_PASSWORD: mysecretpassword
