apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  labels:
    app.kubernetes.io/name: backend
    app.kubernetes.io/component: api
type: Opaque
stringData:
  # IMPORTANT: Replace this value in production!
  # Generate a secure secret: openssl rand -hex 32
  # Use: kubectl create secret generic backend-secret --from-literal=...
  # Or use sealed-secrets/external-secrets for production
  JWT_SECRET: replace-with-secure-secret-at-least-32-bytes
